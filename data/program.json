  "phases": {
    "foundation": {
      "name": "Foundation",
      "weeks": [
        1,
        2
      ]
    },
    "build": {
      "name": "Build",
      "weeks": [
        3,
        4
      ]
    },
    "taper": {
      "name": "Taper",
      "weeks": [
        5
      ],
      "note": "Thanksgiving week"
    }
  },
  "days": {
    "A": {
      "name": "Day A",
      "focus": "Jumps and leg strength"
    },
    "B": {
      "name": "Day B",
      "focus": "Volleyball movement and posterior chain"
    }
  },
  "blocks": [
    {
      "id": "warmup",
      "name": "Warm-up",
      "minutes": 10,
      "note": "FIFA 11+ Part 1 running drills, then snap-downs."
    },
    {
      "id": "jumps",
      "name": "Jumps",
      "minutes": 15,
      "note": "Rest 60–90 s between sets. Stick every landing."
    },
    {
      "id": "strength",
      "name": "Strength and core",
      "minutes": 20
    },
    {
      "id": "volleyball",
      "name": "Volleyball skills",
      "minutes": 35,
      "minutesWithSwim": 15,
      "note": "Do the drills below first, then use the rest of the time for serving, passing, approach footwork and defensive drills.",
      "openNote": "Open practice: serving, passing, approach footwork and defensive drills."
    },
    {
      "id": "shoulder",
      "name": "Shoulder care",
      "minutes": 5
    },
    {
      "id": "swim",
      "name": "Swim",
      "minutes": 25,
      "onlyWithSwim": true,
      "note": "Always last, after the dryland work."
    },
    {
      "id": "cooldown",
      "name": "Cool-down",
      "minutes": 5,
      "onlyWithoutSwim": true,
      "note": "Easy walk and stretching."
    }
  ],
  "swimPlans": {
    "foundation": {
      "name": "Easy swim",
      "minutes": 25,
      "note": "Mostly easy freestyle with kick sets and backstroke.",
      "sets": [
        {
          "label": "Warm-up",
          "detail": "200 yd easy freestyle",
          "yards": 200
        },
        {
          "label": "Kick",
          "detail": "4 × 50 yd kick with kickboard, 20 s rest",
          "yards": 200,
          "exerciseId": "swim-kick-set"
        },
        {
          "label": "Backstroke",
          "detail": "4 × 50 yd easy backstroke, 20 s rest",
          "yards": 200,
          "exerciseId": "backstroke"
        },
        {
          "label": "Easy swim",
          "detail": "200 yd easy freestyle",
          "yards": 200
        },
        {
          "label": "Cool-down",
          "detail": "100 yd easy, any stroke",
          "yards": 100
        }
      ]
    },
    "build": {
      "name": "Swim with strong 50s",
      "minutes": 30,
      "note": "Easy swimming plus 6–8 × 50 yd at a strong pace.",
      "sets": [
        {
          "label": "Warm-up",
          "detail": "200 yd easy freestyle",
          "yards": 200
        },
        {
          "label": "Kick",
          "detail": "4 × 50 yd kick with kickboard, 20 s rest",
          "yards": 200,
          "exerciseId": "swim-kick-set"
        },
        {
          "label": "Strong 50s",
          "detail": "6–8 × 50 yd freestyle at a strong pace, 30 s rest",
          "yards": 300
        },
        {
          "label": "Backstroke",
          "detail": "4 × 50 yd easy backstroke, 20 s rest",
          "yards": 200,
          "exerciseId": "backstroke"
        },
        {
          "label": "Cool-down",
          "detail": "100 yd easy, any stroke",
          "yards": 100
        }
      ]
    },
    "taper": {
      "name": "Easy taper swim",
      "minutes": 25,
      "note": "Week 5: easy swimming only.",
      "sets": [
        {
          "label": "Warm-up",
          "detail": "200 yd easy freestyle",
          "yards": 200
        },
        {
          "label": "Kick",
          "detail": "4 × 50 yd easy kick with kickboard",
          "yards": 200,
          "exerciseId": "swim-kick-set"
        },
        {
          "label": "Backstroke",
          "detail": "4 × 50 yd easy backstroke",
          "yards": 200,
          "exerciseId": "backstroke"
        },
        {
          "label": "Easy swim",
          "detail": "200 yd easy freestyle",
          "yards": 200
        }
      ]
    },
    "serving-day": {
      "name": "Easy kick-heavy swim",
      "minutes": 25,
      "note": "Serving day: keep the swim easy and kick-heavy to spare the shoulder.",
      "sets": [
        {
          "label": "Warm-up",
          "detail": "200 yd easy freestyle",
          "yards": 200
        },
        {
          "label": "Kick",
          "detail": "6 × 50 yd kick with kickboard, 20 s rest",
          "yards": 300,
          "exerciseId": "swim-kick-set"
        },
        {
          "label": "Backstroke",
          "detail": "4 × 50 yd easy backstroke",
          "yards": 200,
          "exerciseId": "backstroke"
        },
        {
          "label": "Cool-down",
          "detail": "100 yd easy, any stroke",
          "yards": 100
        }
      ]
    }
  },
  "safety": [
    "Stick every landing: soft knees, knees over toes, hold it.",
    "Take at least one full rest day every week.",
    "Pain below the kneecap, at the heel, or in the shoulder? Stop and tell a parent."
  ],
